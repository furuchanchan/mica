#!/usr/bin/python3
"""Mica のつなぎ先を見る・つなぐ・確かめる。

  ./mica status                       今どの段まで使えるか、Mac の外のどこへ送るか
  ./mica connect                      外の AI（かこの Mac の LLM）をつなぐ。聞かれた順に答える
  ./mica connect ollama --model qwen3:4b --advice --analysis      聞かれずにつなぐ
  ./mica connect 名前 --base-url http://…/v1 [--key-env 環境変数]   OpenAI 互換のサーバーを足してつなぐ
  ./mica disconnect advice|analysis|check|all                    つなぎを外す
  ./mica doctor                       入っている物を確かめ、つないだ先を実際に1回ずつ試す

鍵は Keychain に置く（設定ファイルには書かない）。送るのは、ここでつないだ先だけ。
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import unicodedata
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / 'service'))
import mica_config  # noqa: E402
import mica_connect  # noqa: E402
import mica_llm  # noqa: E402

from mica_connect import CHOICES, DEFAULT_MODELS, ROLES, key_source, raw_config, role_line, write_config  # noqa: E402,F401


def ask(prompt: str, default: str = '') -> str:
    if not sys.stdin.isatty():
        raise SystemExit(f'答えが要ります: {prompt}（聞かれずにつなぐ時は ./mica connect --help の引数で渡してください）')
    answer = input(f'{prompt}{f" [{default}]" if default else ""}: ').strip()
    return answer or default


def pad(text: str, width: int) -> str:
    """全角を2桁と数えて、右を空白で埋める。"""
    used = sum(2 if unicodedata.east_asian_width(char) in 'WFA' else 1 for char in text)
    return text + ' ' * max(0, width - used)


def status(_args) -> int:
    seen = mica_connect.overview(choices=False)
    print(f'Mica のつなぎ先（設定: {seen["config_path"]}）\n')
    print('  段1  ' + pad('録音と文字起こし', 22) + 'Mac の中だけで動きます（鍵は要りません）')
    for number, stage in enumerate(seen['stages'], 2):
        print(f'  段{number}  ' + pad(stage['title'], 22) + stage['text'])
    if seen['check']:
        print('       ' + pad('文字起こしの2重確認', 22) + f'{seen["check"]["spec"]}（'
              + ('使えます' if seen['check']['usable'] else '使えません。鍵・設定・MICA_NO_CLOUDを確認してください') + '）')
    for item in seen['integrations']:
        print('       ' + pad(item['title'], 22) + ('有効' if item['active'] else 'MICA_NO_CLOUD=1 のため停止'))
    print('\nMac の外へ送る先: ' + ('、'.join(seen['outside']) or 'なし（音声も文字も Mac の外へ出ません）'))
    if seen['no_cloud']:
        print('MICA_NO_CLOUD=1 が付いています。この Mac の外の AI へは送りません。')
    missing = [stage['title'] for stage in seen['stages'] if not stage['usable']]
    if missing:
        print('次の一歩: ./mica connect（' + '・'.join(missing) + 'をつなぐ。Mica の画面では Mica > AI をつなぐ…）')
    return 0


def store_key(name: str, found: dict) -> None:
    """鍵が環境変数にも Keychain にも無ければ、Keychain に入れる。鍵は security が直接聞く（この道具は鍵を読まない）。"""
    if mica_config.stored_key(found['key_env'], f'{name}-api-key'):
        return
    if not sys.stdin.isatty():
        raise SystemExit(f'{found["label"]} の鍵が見つかりません。環境変数 {found["key_env"]} に入れるか、'
                         f'ターミナルで security add-generic-password -U -s {name}-api-key -a mica -w を実行してください。')
    print(f'{found["label"]} の鍵を Keychain（{name}-api-key）に入れます。鍵を貼って Return を押してください（画面には出ません。2回聞かれます）。')
    done = subprocess.run(['security', 'add-generic-password', '-U', '-s', f'{name}-api-key', '-a', 'mica', '-w'])
    if done.returncode:
        raise SystemExit('鍵を Keychain に入れられませんでした。')
    mica_config.stored_key.cache_clear()


def choose_model(name: str, found: dict, given) -> str:
    if given:
        return given
    try:
        listed = mica_llm.models(found)
    except RuntimeError as error:
        raise SystemExit(str(error))
    if not listed and name == 'ollama':
        raise SystemExit('Ollama にモデルが入っていません。先に ollama pull <モデル名> で入れてください。')
    default = DEFAULT_MODELS.get(name, '')
    if default not in listed:
        default = listed[0] if len(listed) == 1 else ''
    if listed:
        print('使えるモデル:')
        for item in listed[:40]:
            print(f'  {item}')
        if len(listed) > 40:
            print(f'  …ほか {len(listed) - 40} 件')
    model = ask('使うモデルの名前', default)
    if not model:
        raise SystemExit('モデルの名前が要ります。')
    return model


def connect(args) -> int:
    name = args.provider
    if not name:
        print('つなぐ先を選んでください。')
        for index, (key, text, _) in enumerate(CHOICES, 1):
            print(f'  {index}) {key.ljust(11)}{text}')
        print('  ほかの OpenAI 互換のサーバーは: ./mica connect 名前 --base-url http://…/v1')
        answer = ask('番号か名前')
        name = CHOICES[int(answer) - 1][0] if answer.isdigit() and 0 < int(answer) <= len(CHOICES) else answer
    if args.key_env and not args.base_url:
        raise SystemExit('--key-env は --base-url と一緒に指定してください。')
    roles = [role for role in ROLES if getattr(args, role)]
    try:
        if name == 'claude_cli':
            done = mica_connect.connect(name, args.model, roles + ['analysis'], args.base_url, args.key_env,
                                        transcription_check=args.transcription_check)
            print(done['message'])
            return status(args)
        if args.transcription_check and name != 'openai':
            raise SystemExit('--transcription-check は openai の時だけ指定できます。')
        found = mica_connect.candidate(raw_config(), name, args.base_url, args.key_env)
        if found['key_env']:
            store_key(name, found)
            found['key'] = mica_config.stored_key(found['key_env'], f'{name}-api-key')
        check_only = args.transcription_check and not roles
        model = None if check_only else choose_model(name, found, args.model)
        if not roles and not check_only:
            answer = ask('何に使いますか  1) 会議中の助言と質問  2) 会議後の分析  3) 両方', '3')
            if answer not in ('1', '2', '3'):
                raise SystemExit('1・2・3 のどれかを指定してください。')
            roles = {'1': ['advice'], '2': ['analysis'], '3': list(ROLES)}[answer]
        audio = name == 'openai' and (args.transcription_check or (not args.model and sys.stdin.isatty() and ask(
            '文字起こしの2重確認もオンにしますか（会議中の音声が OpenAI へ送られます） y/N', 'N').lower().startswith('y')))
        if not args.no_check and roles:
            print(f'{found["label"]} の {model} を1回試します…')
        done = mica_connect.connect(name, model, roles, args.base_url, args.key_env,
                                    transcription_check=bool(audio), test=not args.no_check)
    except ValueError as error:
        raise SystemExit(str(error)) from None
    if done['seconds'] is not None:
        print(f'返事が来ました（{done["seconds"]:.1f}秒）。')
    print(done['message'])
    if not check_only:
        print('Mica を開いていれば、次の呼び出しから使えます。\n')
    return status(args)


def disconnect(args) -> int:
    mica_connect.disconnect(args.target)
    print('外しました。鍵は Keychain に残っています。消す時は security delete-generic-password -s <会社>-api-key を実行してください。\n')
    return status(args)


def running(script: str) -> bool:
    path = str(mica_config.app_support() / 'service' / script)
    return subprocess.run(['pgrep', '-f', path], capture_output=True).returncode == 0


def doctor(_args) -> int:
    failed = 0

    def line(ok, title: str, detail: str = '') -> None:
        nonlocal failed
        failed += ok is False
        print(f'  {"OK" if ok else "－" if ok is None else "NG"}  {title}' + (f'  {detail}' if detail else ''))

    print('入っている物')
    try:
        mica_config.config()
        line(True, '設定ファイル', str(mica_config.config_path()) + ('' if mica_config.config_path().exists() else '（無いので全部既定）'))
    except ValueError as error:
        line(False, '設定ファイル', str(error))
        return 1
    support = mica_config.app_support()
    app = Path(os.environ.get('MICA_APP_DIR') or '~/Applications').expanduser() / 'Mica.app'
    line(app.is_dir(), 'Mica.app', str(app) if app.is_dir() else './install.sh を実行してください')
    line((support / 'MicaRecorder.app').is_dir(), '録画アプリ MicaRecorder', '' if (support / 'MicaRecorder.app').is_dir() else './install.sh を実行してください')
    line((support / 'asr-runtime' / '.venv').is_dir(), '音声認識の実行環境')
    here = Path(__file__).resolve().parent / 'service'
    stale = [path.name for path in sorted(here.glob('*.py')) if not path.name.startswith('test_')
             and (not (support / 'service' / path.name).is_file() or (support / 'service' / path.name).read_bytes() != path.read_bytes())]
    line(not stale, '入っているサービス', 'このフォルダの物と同じ' if not stale else f'このフォルダの物と違います（{stale[0]} など {len(stale)} 件）。./install.sh を動かし直してください')
    line(running('shodan_asr_service.py'), '音声認識の常駐', '' if running('shodan_asr_service.py') else f'ログ: {support}/logs/')
    line(running('shodan_watch.py'), '見張り役の常駐', '' if running('shodan_watch.py') else f'ログ: {support}/logs/')
    ffmpeg = mica_config.config()['ffmpeg'] or shutil.which('ffmpeg')
    line(bool(ffmpeg), 'ffmpeg', ffmpeg or 'brew install ffmpeg')
    print('つないだ先（実際に1回ずつ試します）')
    for role, title in ROLES.items():
        spec = mica_config.ai_spec(role)
        if not spec:
            line(None, title, 'つないでいません（./mica connect）')
        elif role == 'analysis' and mica_config.analysis_engine() == 'claude_cli':
            if not mica_config.cloud_allowed():
                line(False, title, 'MICA_NO_CLOUD=1 のため使いません')
                continue
            found = shutil.which('claude')
            version = subprocess.run([found, '--version'], capture_output=True, text=True).stdout.strip() if found else ''
            line(bool(found), title, f'{spec}（Claude Code {version}。分析そのものは試していません）' if found else 'claude コマンドが見つかりません')
        else:
            try:
                line(True, title, f'{spec}（返事まで {mica_llm.check(role):.1f}秒）')
            except RuntimeError as error:
                line(False, title, f'{spec}: {error}')
    print('\n問題は見つかりませんでした。' if not failed else f'\nNG が {failed} 件あります。')
    return 1 if failed else 0


def main() -> int:
    parser = argparse.ArgumentParser(prog='mica', description='Mica のつなぎ先を見る・つなぐ・確かめる')
    commands = parser.add_subparsers(dest='command')
    commands.add_parser('status', help='今どの段まで使えるか、Mac の外のどこへ送るか').set_defaults(run=status)
    one = commands.add_parser('connect', help='外の AI か、この Mac の LLM をつなぐ')
    one.add_argument('provider', nargs='?', help='ollama / lmstudio / openai / anthropic / gemini / openrouter / groq / claude_cli / 自分で付ける名前')
    one.add_argument('--model', help='モデルの名前（省くと一覧から選ぶ）')
    one.add_argument('--advice', action='store_true', help='会議中の助言と質問に使う')
    one.add_argument('--analysis', action='store_true', help='会議後の分析に使う')
    one.add_argument('--base-url', help='OpenAI 互換のサーバーの URL（http://…/v1）。組み込みに無い先をつなぐ時')
    one.add_argument('--key-env', help='--base-url のサーバーの鍵を入れた環境変数の名前（鍵が要らなければ省く）')
    one.add_argument('--transcription-check', action='store_true', help='openai の時：文字起こしの2重確認もオンにする（音声が OpenAI へ送られる）')
    one.add_argument('--no-check', action='store_true', help='つないだ後の試しの1回を省く')
    one.set_defaults(run=connect)
    two = commands.add_parser('disconnect', help='つなぎを外す')
    two.add_argument('target', choices=['advice', 'analysis', 'check', 'all'])
    two.set_defaults(run=disconnect)
    commands.add_parser('doctor', help='入っている物を確かめ、つないだ先を実際に1回ずつ試す').set_defaults(run=doctor)
    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 0
    try:
        return args.run(args)
    except ValueError as error:  # 設定の誤り
        raise SystemExit(str(error))
    except OSError as error:
        raise SystemExit(f'設定ファイルか必要なコマンドを読み書きできません: {error}') from None
    except (KeyboardInterrupt, EOFError):
        print()
        return 130


if __name__ == '__main__':
    sys.exit(main())
